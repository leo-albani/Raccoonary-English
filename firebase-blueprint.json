{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User account profile and streak metadata",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" },
        "streakCount": { "type": "number" },
        "lastActiveDate": { "type": "string", "maxLength": 32 },
        "totalAcorns": { "type": "number" },
        "reminderEnabled": { "type": "boolean" },
        "reminderTime": { "type": "string", "maxLength": 16 },
        "onboardingCompleted": { "type": "boolean" },
        "currentLevel": { "type": "string", "maxLength": 16 },
        "lastTestDate": { "type": "number" },
        "firstName": { "type": "string", "maxLength": 128 },
        "lastName": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 128 },
        "nativeLanguage": { "type": "string", "maxLength": 16 },
        "activeProfileId": { "type": "string", "maxLength": 16 },
        "legacyMigrated": { "type": "boolean" },
        "fcmToken": { "type": "string", "maxLength": 512 },
        "fcmTokens": { "type": "array" },
        "lastReminderSentDate": { "type": "string", "maxLength": 32 },
        "tutorialCompleted": { "type": "boolean" }
      },
      "required": ["userId", "createdAt"]
    },
    "VocabItem": {
      "title": "Vocab Item",
      "description": "Vocabulary item stored in the tanaleitner box system",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "term": { "type": "string", "maxLength": 1000 },
        "translation": { "type": "string", "maxLength": 1000 },
        "sourceLang": { "type": "string", "maxLength": 10 },
        "targetLang": { "type": "string", "maxLength": 10 },
        "exampleSource": { "type": "string", "maxLength": 2000 },
        "exampleTranslation": { "type": "string", "maxLength": 2000 },
        "origin": { "type": "string", "maxLength": 64 },
        "originDetail": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "number" },
        "lastReviewedAt": { "type": "number" },
        "box": { "type": "number" },
        "nextReviewAt": { "type": "number" },
        "correctStreak": { "type": "number" },
        "wrongCount": { "type": "number" },
        "usageNote": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "term", "translation", "origin", "createdAt", "box", "nextReviewAt"]
    },
    "ExerciseError": {
      "title": "Exercise Error",
      "description": "Mistakes made during grammar, placement level test, or reading comprehension to review via Leitner system",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "domanda": { "type": "string", "maxLength": 2000 },
        "rispostaCorretta": { "type": "string", "maxLength": 1000 },
        "tipo": { "type": "string", "maxLength": 64 },
        "argomentoRiferimento": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "number" },
        "box": { "type": "number" },
        "nextReviewAt": { "type": "number" },
        "wrongCount": { "type": "number" },
        "lastReviewedAt": { "type": "number" },
        "correctStreak": { "type": "number" },
        "spiegazione": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "domanda", "rispostaCorretta", "tipo", "argomentoRiferimento", "createdAt", "box", "nextReviewAt", "wrongCount"]
    },
    "GrammarTopicProgress": {
      "title": "Grammar Topic Progress",
      "description": "Progress tracking for individual grammar syllabus topics",
      "type": "object",
      "properties": {
        "topicId": { "type": "string", "maxLength": 128 },
        "topicName": { "type": "string", "maxLength": 256 },
        "exercisesCompleted": { "type": "number" },
        "lastGeneratedAt": { "type": "number" },
        "passed": { "type": "boolean" },
        "bestScorePercent": { "type": "number" },
        "lastScorePercent": { "type": "number" },
        "attemptsCount": { "type": "number" }
      },
      "required": ["topicId", "topicName"]
    },
    "LevelTestResult": {
      "title": "Level Test Result",
      "description": "Cambridge-style CEFR placement test history record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "takenAt": { "type": "number" },
        "resultLevel": { "type": "string", "maxLength": 16 },
        "totalCorrect": { "type": "number" },
        "totalQuestions": { "type": "number" }
      },
      "required": ["id", "takenAt", "resultLevel", "totalCorrect", "totalQuestions"]
    },
    "UserLanguageProfile": {
      "title": "User Language Profile",
      "description": "Language-specific user progress and metrics profile",
      "type": "object",
      "properties": {
        "targetLanguage": { "type": "string", "maxLength": 16 },
        "createdAt": { "type": "number" },
        "currentLevel": { "type": "string", "maxLength": 16 },
        "streakCount": { "type": "number" },
        "totalAcorns": { "type": "number" },
        "lastActiveDate": { "type": "string", "maxLength": 32 },
        "reminderEnabled": { "type": "boolean" },
        "reminderTime": { "type": "string", "maxLength": 16 },
        "fcmToken": { "type": "string", "maxLength": 512 },
        "fcmTokens": { "type": "array" },
        "lastReminderSentDate": { "type": "string", "maxLength": 32 }
      },
      "required": ["targetLanguage", "createdAt", "streakCount", "totalAcorns"]
    },
    "SharedLanguagePairContent": {
      "title": "Shared Language Pair Content",
      "description": "Shared grammar syllabus, special sections, and irregular verbs per language pair",
      "type": "object",
      "properties": {
        "generatedAt": { "type": "number" },
        "generatedBy": { "type": "string", "maxLength": 32 }
      },
      "required": ["generatedAt", "generatedBy"]
    },
    "UITranslation": {
      "title": "UI Translation",
      "description": "Localized interface strings for a spoken language",
      "type": "object",
      "properties": {
        "langCode": { "type": "string", "maxLength": 16 },
        "strings": { "type": "object" },
        "generatedAt": { "type": "number" }
      },
      "required": ["langCode", "strings"]
    },
    "LessonPath": {
      "title": "Guided Lesson Path",
      "description": "Sequential 8-lesson guided path with checkpoint and mini-test",
      "type": "object",
      "properties": {
        "livelloTarget": { "type": "string", "maxLength": 16 },
        "lezioni": { "type": "array" },
        "checkpointSuperato": { "type": "boolean" },
        "miniTestSuperato": { "type": "boolean" },
        "creatoIl": { "type": "number" }
      },
      "required": ["livelloTarget", "lezioni", "creatoIl"]
    },
    "ScenarioRecord": {
      "title": "Scenario Record",
      "description": "Real life contextual scenario practice record",
      "type": "object",
      "properties": {
        "scenarioId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "maxLength": 32 },
        "completedAt": { "type": "number" },
        "lastPracticedAt": { "type": "number" }
      },
      "required": ["scenarioId", "title", "status"]
    }
  },
  "firestore": {
    "/translations/{langCode}": {
      "schema": "UITranslation",
      "description": "Interface translation strings per language"
    },
    "/sharedContent/{pairId}": {
      "schema": "SharedLanguagePairContent",
      "description": "Shared language pair syllabus and reference materials"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/profiles/{profileId}": {
      "schema": "UserLanguageProfile",
      "description": "Language target profile"
    },
    "/users/{userId}/profiles/{profileId}/vocabItems/{itemId}": {
      "schema": "VocabItem",
      "description": "Language profile vocabulary collection"
    },
    "/users/{userId}/profiles/{profileId}/exerciseErrors/{errorId}": {
      "schema": "ExerciseError",
      "description": "Language profile exercise mistakes collection for Leitner review"
    },
    "/users/{userId}/profiles/{profileId}/grammarProgress/{topicId}": {
      "schema": "GrammarTopicProgress",
      "description": "Language profile grammar topic progress subcollection"
    },
    "/users/{userId}/profiles/{profileId}/levelTests/{testId}": {
      "schema": "LevelTestResult",
      "description": "Language profile CEFR level test attempt history"
    },
    "/users/{userId}/profiles/{profileId}/scenarios/{scenarioId}": {
      "schema": "ScenarioRecord",
      "description": "Language profile scenario practice progress"
    },
    "/users/{userId}/profiles/{profileId}/lessonPath/{pathId}": {
      "schema": "LessonPath",
      "description": "Language profile 8-lesson guided pathway state"
    },
    "/users/{userId}/vocabItems/{itemId}": {
      "schema": "VocabItem",
      "description": "User vocabulary collection"
    },
    "/users/{userId}/grammarProgress/{topicId}": {
      "schema": "GrammarTopicProgress",
      "description": "User grammar topic progress subcollection"
    },
    "/users/{userId}/levelTests/{testId}": {
      "schema": "LevelTestResult",
      "description": "User CEFR level test attempt history"
    }
  }
}
